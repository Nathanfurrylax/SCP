# Copie ce fichier vers .env et complète les valeurs.
FLASK_SECRET_KEY=remplace-par-une-longue-cle-aleatoire
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:5000/auth/callback
# IDs numériques Discord, séparés par des virgules : ton ID, puis celui du collaborateur
ADMIN_DISCORD_IDS=TON_ID_DISCORD,ID_DISCORD_COLLABORATEUR
FLASK_DEBUG=0
